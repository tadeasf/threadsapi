# Spring Boot .dockerignore

# Build outputs
build/
target/
*.jar
*.war

# IDE files
.vscode/
.idea/
*.iml
*.ipr
*.iws

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Documentation
README.md
HELP.md
ARCHITECTURE_REVIEW.md

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# Environment files
.env
.env.local
.env.*.local

# Node.js (for frontend)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker files
Dockerfile*
docker-compose*.yml
docker-compose*.yaml

# Gradle wrapper jar (will be copied separately)
gradle/wrapper/gradle-wrapper.jar 