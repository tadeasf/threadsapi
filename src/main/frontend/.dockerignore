# Next.js .dockerignore

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
.next/
out/
build/
dist/

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Git
.git/
.gitignore
.gitattributes

# Documentation
README.md
*.md

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp

# Testing
coverage/
.nyc_output/

# Docker files
Dockerfile*
docker-compose*.yml
docker-compose*.yaml

# Misc
.eslintcache
.vercel 